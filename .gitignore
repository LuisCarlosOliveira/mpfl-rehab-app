# Dependencies and build output
node_modules
dist/
*.tsbuildinfo
.vite/
.vitest/
coverage/

# Test output (Playwright, Vitest)
playwright-report/
test-results/
blob-report/

# Local tool output: clips that the clip tool writes
.clip-out/

# Logs
*.log
npm-debug.log*

# Secrets and local settings. Never commit these.
.env
.env.*
!.env.example
*.pem
*.key
.npmrc.local

# Claude Code files stay local.
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# Git worktrees that sit inside this folder
/mpfl-rehab-app-*/

# Video, camera and recording files. The app never stores a frame or a video,
# so a file like this in the repo is always a mistake.
*.mp4
*.webm
*.mov
*.avi
*.mkv
*.m4v
*.yuv

# Operating system and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
