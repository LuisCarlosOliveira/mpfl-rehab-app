/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; worker-src 'self' blob:; media-src 'self' blob:; img-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Permissions-Policy: camera=(self), microphone=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The model and WASM files have no hash in their names. A hash check at build time (scripts/model-hash-check.sh)
# keeps them the same between releases of one model. One day of cache lets a second visit skip about 20 MB.
# After one day the browser asks the host again, and a file that did not change answers 304 (must-revalidate).
# The longest wait for a changed model is one day. This is why the files are not immutable.
/models/*
  Cache-Control: public, max-age=86400, must-revalidate
